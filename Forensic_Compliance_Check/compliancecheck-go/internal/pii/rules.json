{
  "rules": [
    {
      "id": "EMAIL",
      "label": "Email address",
      "pattern": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}",
      "severity": "medium",
      "checksum": "none"
    },
    {
      "id": "IPV4",
      "label": "IPv4 address",
      "pattern": "\\b(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\b",
      "severity": "low",
      "checksum": "none"
    },
    {
      "id": "CREDIT_CARD",
      "label": "Credit card number",
      "pattern": "\\b(?:\\d[ -]?){13,19}\\b",
      "severity": "critical",
      "checksum": "luhn",
      "min_digits": 13,
      "max_digits": 19,
      "context_keywords": {
        "en": ["card", "visa", "mastercard", "amex", "credit", "debit", "cvv", "expir"],
        "fr": ["carte", "crédit", "débit", "expiration"],
        "es": ["tarjeta", "crédito", "débito", "vencimiento"],
        "de": ["karte", "kredit", "ablauf"]
      }
    },
    {
      "id": "SSN_US",
      "label": "US Social Security Number",
      "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "severity": "critical",
      "checksum": "ssn_us",
      "context_keywords": {
        "en": ["ssn", "social security"]
      }
    },
    {
      "id": "SIN_CA",
      "label": "Canadian Social Insurance Number",
      "pattern": "\\b\\d{3}[ -]\\d{3}[ -]\\d{3}\\b",
      "severity": "critical",
      "checksum": "luhn",
      "min_digits": 9,
      "max_digits": 9,
      "context_keywords": {
        "en": ["sin", "social insurance"],
        "fr": ["nas", "assurance sociale"]
      }
    },
    {
      "id": "AWS_ACCESS_KEY",
      "label": "AWS access key",
      "pattern": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b",
      "severity": "critical",
      "checksum": "none"
    },
    {
      "id": "PRIVATE_KEY_BLOCK",
      "label": "Private key material",
      "pattern": "-----BEGIN (RSA |EC |OPENSSH |DSA |)PRIVATE KEY-----",
      "severity": "critical",
      "checksum": "none"
    },
    {
      "id": "GENERIC_API_KEY",
      "label": "Generic API key / secret assignment",
      "pattern": "(?i)(api[_-]?key|secret|token|passwd|password)['\"]?\\s*[:=]\\s*['\"][A-Za-z0-9_\\-]{16,}['\"]",
      "severity": "high",
      "checksum": "none"
    },
    {
      "id": "PHONE_GENERIC",
      "label": "Phone number",
      "pattern": "\\b(?:\\+?\\d{1,3}[ .\\-]?)?(?:\\(?\\d{3}\\)?[ .\\-]?)\\d{3}[ .\\-]?\\d{4}\\b",
      "severity": "low",
      "checksum": "none",
      "context_keywords": {
        "en": ["phone", "call", "mobile", "cell", "tel"],
        "fr": ["téléphone", "tél", "mobile", "portable"],
        "es": ["teléfono", "tel", "móvil"],
        "de": ["telefon", "handy", "mobil"]
      }
    },
    {
      "id": "PASSPORT_GENERIC",
      "label": "Possible passport number",
      "pattern": "\\b[A-Z]{1,2}\\d{6,9}\\b",
      "severity": "medium",
      "checksum": "none",
      "context_keywords": {
        "en": ["passport"],
        "fr": ["passeport"],
        "es": ["pasaporte"],
        "de": ["reisepass", "pass"]
      }
    }
  ]
}
